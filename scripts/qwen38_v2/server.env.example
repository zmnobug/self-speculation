# Copy to server.env on the experiment server and replace every /ABS/... path.
# The runner refuses unresolved placeholders.

V2_PYTHON=/ABS/PATH/TO/CONDA/ENV/bin/python
V2_DRIVER_MODULE=experiments.qwen38
# File or directory containing the server-side adapter implementation. It is
# hashed into every gate marker, so changing the harness invalidates old PASSes.
V2_DRIVER_SOURCE=/ABS/PATH/TO/self-speculation/experiments/qwen38
V2_MODEL_NAME=qwen3.8-27b
V2_TOKENIZER_PATH=/ABS/PATH/TO/Qwen3.8-27B
V2_BASE_URL=http://127.0.0.1:8000/v1

# Each launcher must stay in the foreground and use `exec vllm ...` so the
# runner can stop exactly the server it started. Do not daemonize inside it.
V2_PLAIN_SERVER_LAUNCHER=/ABS/PATH/TO/launch-v2-plain.sh
V2_COMPOSITE_SERVER_LAUNCHER=/ABS/PATH/TO/launch-v2-composite.sh

V2_PROTOCOL=/ABS/PATH/TO/QWEN38_LOCKED_PROTOCOL.json
V2_GATE0_EVIDENCE=/ABS/PATH/TO/gate0-v2.json
# Exactly 10 fixed tasks with read-only tool calls. This is the only measured
# manifest used by the Quick10 timing diagnostic.
V2_MANIFEST_QUICK10=/ABS/PATH/TO/manifests/tau2-airline-quick10-seed42.json
V2_MANIFEST_SMOKE=/ABS/PATH/TO/manifests/tau2-smoke-10.json
V2_MANIFEST_AIRLINE=/ABS/PATH/TO/manifests/tau2-airline-43.json
V2_MANIFEST_FULL=/ABS/PATH/TO/manifests/tau2-full-155.json
V2_D2_MANIFEST=/ABS/PATH/TO/manifests/tau2-dev-30.json

V2_RUNS_ROOT=/ABS/PATH/TO/runs/v2
V2_STATE_DIR=/ABS/PATH/TO/runs/v2/.state
V2_RESULTS_ROOT=/ABS/PATH/TO/results/v2
V2_WARMUP_REQUESTS=10
V2_TASK_TIMEOUT_S=900
V2_BOOTSTRAP_ITERS=10000
V2_SERVER_START_TIMEOUT_S=300
V2_UNITTEST_TIMEOUT_S=600
V2_PLAIN_TREATMENT=d1-d2
V2_QUICK_REPEATS=1
